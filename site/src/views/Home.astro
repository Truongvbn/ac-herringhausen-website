---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import EventRows from '../components/EventRows.astro';
import Downloads from '../components/Downloads.astro';
import MapBlock from '../components/MapBlock.astro';
import Probe from '../components/Probe.astro';
import Icon from '../components/Icon.astro';
import { club, meetings, partners, events2026, type Lang } from '../data/club';
import { href } from '../i18n/routes';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const de = lang === 'de';
const t = ui[lang];
const G = '/img/galerie/jugend-kart/';
const today = new Date().toISOString().slice(0, 10);
const done = events2026.filter((e) => e.date < today).length;
const over = done === events2026.length;
const pos = (d: string) => (((Date.parse(d) - Date.parse('2026-01-01')) / 864e5 / 365) * 100).toFixed(1);
const dm = (d: string) => `${d.slice(8, 10)}.${d.slice(5, 7)}.`;
const months = (de ? ['Jan', 'Apr', 'Jul', 'Okt'] : ['Jan', 'Apr', 'Jul', 'Oct']).map((m, i) => ({ m, x: pos(`2026-${['01', '04', '07', '10'][i]}-01`) }));
const strip = [
  { f: 'img-1913', a: de ? 'Gelbes Kart in der Kurve zwischen Pylonen' : 'Yellow kart cornering between pylons', c: de ? 'Kurvenfahrt durch die Pylonen' : 'Cornering through the pylons' },
  { f: 'img-1958', a: de ? 'Kart auf dem Slalomkurs mit Streckenposten' : 'Kart on the slalom course with a marshal', c: de ? 'Auf dem Slalomkurs, Streckenposten im Blick' : 'On the slalom course, marshal in view' },
  { f: 'img-1921', a: de ? 'Kart auf der Strecke, gelber Sonnenschirm und Pylonen' : 'Kart on track, yellow parasol and pylons', c: de ? 'Auf der Strecke' : 'On track' },
  { f: 'img-1910', a: de ? 'Zwei gelbe Karts warten am Start' : 'Two yellow karts waiting at the start', c: de ? 'Zwei Karts warten am Start' : 'Two karts waiting at the start' },
  { f: 'img-1959', a: de ? 'Gelbes Kart auf dem Slalomkurs vor Bäumen' : 'Yellow kart on the slalom course', c: de ? 'Gegen die Zeit' : 'Against the clock' },
  { f: 'img-1842', a: de ? 'Gelbes Kart unter dem roten Pavillon im Fahrerlager' : 'Yellow kart under the red gazebo in the paddock', c: de ? 'Fahrerlager unter dem roten Pavillon' : 'Paddock under the red gazebo' },
  { f: 'img-1859', a: de ? 'Gelbes Kart an der Boxenbank, Frontansicht' : 'Yellow kart at the pit bench, front view', c: de ? 'Kart an der Boxenbank' : 'Kart at the pit bench' },
  { f: 'img-1874', a: de ? 'Tisch voller goldener Pokale vor ADAC-Fahnen' : 'Table full of gold trophies in front of ADAC flags', c: de ? 'Pokale für die Siegerehrung' : 'Trophies for the award ceremony' },
  { f: 'img-1845', a: de ? 'Pylonengasse auf dem Parkplatz' : 'Pylon lane on the car park', c: de ? 'Die Pylonengasse steht' : 'The pylon lane is set' },
];
const aud = [
  { key: 'kart' as const, ic: 'helmet' as const, k: 'Jugend-Kart-Slalom', b: de ? 'Ich bin 8–18 und will Kart fahren' : 'I am 8–18 and want to drive a kart', p: de ? 'Klassen P1 bis P5, Training jeden Samstag um 15 Uhr.' : 'Classes P1 to P5, training every Saturday at 3 pm.', go: de ? 'Zum Kart-Slalom' : 'To kart slalom', hash: '' },
  { key: 'clubsport' as const, ic: 'cone' as const, k: 'Clubsport-Slalom', b: de ? 'Ich fahre Slalom mit meinem Auto' : 'I drive slalom in my own car', p: de ? '2026 lief der 55. ADAC Clubsport-Slalom des ACH.' : 'In 2026 the ACH ran its 55th ADAC Clubsport Slalom.', go: de ? 'Zum Clubsport' : 'To clubsport', hash: '' },
  { key: 'oldtimer' as const, ic: 'car' as const, k: 'Oldtimer-Rallye', b: de ? 'Ich habe einen Oldtimer' : 'I own a classic car', p: de ? 'Unser Oldie-Team startet im 1967er Ford Mustang Fastback.' : 'Our classics team runs a 1967 Ford Mustang Fastback.', go: de ? 'Zum Oldie-Team' : 'To the classics team', hash: '' },
];
---
<Base lang={lang} page="home" chip={false}
  description={de
    ? 'AC Herringhausen e.V. im ADAC: Jugend-Kart-Slalom, Clubsport-Slalom und Oldtimer-Rallye in Herford / Hiddenhausen. Kart-Training jeden Samstag um 15 Uhr.'
    : 'AC Herringhausen e.V. im ADAC: youth kart slalom, clubsport slalom and classic car rallying in Herford / Hiddenhausen, Germany. Kart training every Saturday at 3 pm.'}>

  <div class="hero" id="top">
    <div class="hero-lines ly" aria-hidden="true"></div>
    <div class="hero-ghost ly" aria-hidden="true"><span>ACH</span><span>1969</span></div>
    <div class="w hero-in">
      <figure class="hero-ph"><img src={`${G}img-1953.jpg`} width="1280" height="853" fetchpriority="high"
        alt={de ? 'Gelbes Slalom-Kart mit Fahrer im schwarzen Helm zwischen orangefarbenen Pylonen' : 'Yellow slalom kart with a driver in a black helmet between orange pylons'} /></figure>
      <div class="hero-cheq" aria-hidden="true"></div>
      <div class="hero-copy ly">
        <p class="kick"><b>{de ? 'seit 1969' : 'since 1969'}</b><span>{de ? 'Ortsclub im ADAC Ostwestfalen-Lippe' : 'Local club in the ADAC Ostwestfalen-Lippe'}</span></p>
        <h1><span>Motorsport</span><span>{de ? 'für Jung und Alt.' : 'for young and old.'}</span></h1>
        <p class="lead">{de
          ? 'Herzlich willkommen auf den Seiten des AC Herringhausen e.V. im ADAC: Jugend-Kart-Slalom, Clubsport-Slalom und Oldtimer-Rallye in Herford / Hiddenhausen.'
          : 'Welcome to AC Herringhausen e.V. im ADAC: youth kart slalom, clubsport slalom and classic car rallying in Herford / Hiddenhausen.'}</p>
        <div class="cta">
          <a class="btn red" href={href('kart', lang, '#probetraining')}>{de ? 'Probetraining ab 7 Jahren' : 'Trial session from age 7'}</a>
          <a class="btn" href={href('termine', lang)}>{de ? 'Termine 2026' : 'Events 2026'}</a>
        </div>
      </div>
      <aside class="tower ly" aria-label={t.nextTraining}>
        <p class="tw-head"><span>{t.nextTraining}</span><span>{t.weekly}</span></p>
        <div class="tw-clock" role="timer" aria-label={t.nextTraining}>
          <div><b data-cd="d">00</b><span>{t.days}</span></div><div><b data-cd="h">00</b><span>{t.hrs}</span></div><div><b data-cd="m">00</b><span>{t.min}</span></div><div><b data-cd="s">00</b><span>{t.sec}</span></div>
        </div>
        <dl class="tw-rows">
          <div><dt>{t.saturday}</dt><dd data-next-full>–</dd></div>
          <div><dt>Start</dt><dd>{t.clock}</dd></div>
          <div><dt>{de ? 'Ort' : 'Venue'}</dt><dd>{t.trainingPlace}</dd></div>
        </dl>
        <p class="tw-note">{de ? 'Kart-Training jeden Samstag, außer in den Ferien.' : 'Kart training every Saturday, except during school holidays.'}</p>
      </aside>
    </div>
  </div>

  <section class="sec tight" aria-labelledby="aud-h"><div class="w">
    <h2 class="vh" id="aud-h">{de ? 'Was führt dich zu uns?' : 'What brings you here?'}</h2>
    <ul class="aud">
      {aud.map((a) => (
        <li><a href={href(a.key, lang, a.hash)}><img class="aud-img" src={`/img/art/o-${a.key}.webp`} width="800" height="800" loading="lazy" alt="" /><Icon name={a.ic} /><span class="k">{a.k}</span><b>{a.b}</b><p>{a.p}</p><span class="go">{a.go} →</span></a></li>
      ))}
      <li><a class="parent" href={href('kart', lang, '#eltern')}><img class="aud-img" src="/img/art/helmet.webp" width="1536" height="1024" loading="lazy" alt="" /><Icon name="heart" /><span class="k">{de ? 'Gut zu wissen' : 'Good to know'}</span><b>{de ? 'Ich bin Mama oder Papa' : 'I am a mum or dad'}</b><p>{de ? 'Immer nur ein Fahrer auf der Strecke. Was zum Probetraining mitkommt, steht hier.' : 'Only ever one driver on the track. Here is what to bring to a trial session.'}</p><span class="go">{de ? 'Infos für Eltern' : 'Info for parents'} →</span></a></li>
    </ul>
  </div></section>

  <section class="sec alt" id="termine"><div class="w">
    <SectionHead kick={de ? 'Termine' : 'Events'} h={[de ? 'Saison' : 'Season', '2026']} />
    <p class="track-cap">{de ? `Saison 2026: ${done} von ${events2026.length} Veranstaltungen gefahren` : `Season 2026: ${done} of ${events2026.length} events completed`}</p>
    <div class="track" aria-hidden="true">
      <b style={`width:${today.slice(0, 4) > '2026' ? 100 : pos(today)}%`}></b>
      {events2026.map((e) => <i class:list={{ done: e.date < today }} style={`left:${pos(e.date)}%`}><span>{dm(e.date)}</span></i>)}
      <p class="mon">{months.map((m) => <span style={`left:${m.x}%`}>{m.m}</span>)}</p>
    </div>
    {over && <p class="flag">{de ? 'Saison 2026 beendet · Termine 2027 folgen' : 'Season 2026 finished · 2027 dates to follow'}</p>}
    {/* once the season is over the finished events live on the Termine page; home keeps only what is still ahead */}
    <EventRows lang={lang} events={over ? [] : events2026} />
    <div class="cta"><a class="btn" href={href('termine', lang)}>{de ? 'Alle Termine und Unterlagen' : 'All events and documents'}</a></div>
  </div></section>

  <section class="sec" id="abteilungen"><div class="w">
    <SectionHead kick={de ? 'Abteilungen' : 'Departments'} h={[de ? 'Drei Wege' : 'Three ways', de ? 'an den Start' : 'to the start']} />
    <div class="abt">
      <div class="pan-w"><a class="pan" href={href('kart', lang)}>
        <figure class="pan-img"><img src={`${G}img-1915.jpg`} loading="lazy" width="1280" height="853" alt={de ? 'Gelbes Kart umrundet orangefarbene Pylonen auf dem Parkplatz' : 'Yellow kart rounding orange pylons on the car park'} /></figure>
        <div class="pan-c"><p class="kick"><b>P1–P5</b><span>{de ? '8 bis 18 Jahre' : 'ages 8 to 18'}</span></p>
          <h3>Jugend-Kart-Slalom</h3>
          <p>{de
            ? 'Die Breitensportvariante des Kartsports: Mit Karts wird auf Parkplätzen ein mit Pylonen abgesteckter Kurs gegen die Zeit gefahren. Dabei ist immer nur ein Fahrer auf der Strecke.'
            : 'Grassroots karting: karts are driven against the clock on a pylon course laid out on car parks. There is only ever one driver on the track.'}</p>
          <ul class="rules" style="margin-top:16px">
            <li><b>3</b><span>{de ? 'Läufe: ein Training, zwei Wertung' : 'runs: one practice, two timed'}</span></li>
            <li><b>+2 s</b><span>{de ? 'je Pylonenfehler' : 'per pylon error'}</span></li>
            <li><b>+10 s</b><span>{de ? 'je ausgelassener oder falsch befahrener Aufgabe' : 'per missed or wrongly driven task'}</span></li>
          </ul>
          <span class="go">{de ? 'Alles zum Kart-Slalom' : 'All about kart slalom'} →</span></div>
      </a></div>
      <div class="pan-w"><a class="pan" href={href('clubsport', lang)}>
        <figure class="pan-img"><img src={`${G}img-1845.jpg`} loading="lazy" width="1280" height="853" alt={de ? 'Pylonengasse auf dem Parkplatz, Streckenübersicht' : 'Pylon lane on the car park, course overview'} /></figure>
        <div class="pan-c"><p class="kick"><b>55.</b><span>{de ? 'Auflage 2026' : 'edition in 2026'}</span></p>
          <h3>Clubsport-Slalom</h3>
          <p>{de ? 'Automobil-Slalom mit dem eigenen Auto. 2026 hat der Club den 55. ADAC Automobil-Clubsport-Slalom ausgerichtet.' : 'Automobile slalom in your own car. In 2026 the club hosted the 55th ADAC Automobile Clubsport Slalom.'}</p>
          <span class="go">{de ? 'Zum Clubsport-Slalom' : 'To clubsport slalom'} →</span></div>
      </a></div>
      <div class="pan-w"><a class="pan" href={href('oldtimer', lang)}>
        <figure class="pan-img"><img src="/img/site/mustang2013.jpg" loading="lazy" width="800" height="532" alt={de ? 'Roter Ford Mustang Fastback von 1967 mit Rallyeschild' : 'Red 1967 Ford Mustang Fastback with rally plate'} /></figure>
        <div class="pan-c"><p class="kick"><b>1967</b><span>Ford Mustang Fastback</span></p>
          <h3>Oldtimer-Rallye</h3>
          <p>{de ? 'Unser Oldie-Team: Jochen Gieselmann und Evelyn Erdmann im 1967er Ford Mustang Fastback.' : 'Our classics team: Jochen Gieselmann and Evelyn Erdmann in a 1967 Ford Mustang Fastback.'}</p>
          <span class="go">{de ? 'Zum Oldie-Team' : 'To the classics team'} →</span></div>
      </a></div>
    </div>
    <div style="margin-top:22px"><Probe lang={lang} /></div>
  </div></section>

  <section class="sec alt" id="verein"><div class="w">
    <ul class="stats">
      <li><b>1969</b><span>{de ? 'gegründet am 1. August' : 'founded on 1 August'}</span></li>
      <li><b>{de ? '55.' : '55th'}</b><span>{de ? 'Clubsport-Slalom (2026)' : 'Clubsport slalom (2026)'}</span></li>
      <li><b>3</b><span>{de ? 'Abteilungen' : 'departments'}</span></li>
      <li><b>P1–P5</b><span>{de ? '8 bis 18 Jahre' : 'ages 8 to 18'}</span></li>
    </ul>
    <div class="two" style="margin-top:clamp(36px,5vw,64px)">
      <div>
        <SectionHead kick={de ? 'Über uns' : 'About us'} h={[de ? 'Am Start' : 'On the grid', de ? 'seit 1969' : 'since 1969']} />
        <p style="max-width:58ch">{de
          ? 'Der AC Herringhausen e.V. im ADAC wurde am 1. August 1969 gegründet und prägt seitdem die Motorsportgeschichte der Region. Durch unsere Jugendgruppe und die stark ausgeprägte Rallyeszene im Verein ist der Bestand des ACH für die kommenden Jahrzehnte gesichert.'
          : 'AC Herringhausen e.V. im ADAC was founded on 1 August 1969 and has shaped the region’s motorsport history ever since. Thanks to our youth group and the strong rally scene within the club, the future of the ACH is secured for decades to come.'}</p>
        <div class="cta"><a class="btn" href={href('verein', lang)}>{de ? 'Verein und Vorstand' : 'Club and board'}</a></div>
      </div>
      <div>
        <h3 class="h3" style="margin-bottom:16px">{de ? 'Donnerstags bei Babi' : 'Thursdays at Babi’s'}</h3>
        <div class="life life2">
          {meetings.map((m) => <div class="slot"><b>{m.title[lang]}</b><span>{m.when[lang]}</span><em>{m.time[lang]}</em></div>)}
          <div style="grid-column:1/-1"><MapBlock lang={lang} /></div>
        </div>
      </div>
    </div>
  </div></section>

  <section class="sec" id="galerie"><div class="gal3d" data-gal3d>
    <div class="gal-stage">
      <div class="w"><SectionHead kick={de ? 'Galerie' : 'Gallery'} h={[de ? 'Strecke &' : 'Track &', de ? 'Fahrerlager' : 'paddock']} /></div>
      <ul class="gal-track" tabindex="0" aria-label={de ? 'Bilder, seitlich blättern' : 'Photos, scroll sideways'}>
        {strip.map((s) => <li><figure><img src={`${G}${s.f}.jpg`} loading="lazy" width="1280" height="853" alt={s.a} /><figcaption>{s.c}</figcaption></figure></li>)}
      </ul>
      <div class="w gal-foot">
        <p class="gal-hud" aria-hidden="true"><span class="gal-bar"><i></i></span></p>
        <a class="btn sm" href={href('galerie', lang)}>{de ? 'Alle 82 Bilder ansehen' : 'See all 82 photos'}</a>
      </div>
    </div>
  </div></section>

  <section class="sec art even art-paddock" id="mitglied"><div class="w two">
    <div>
      <SectionHead kick={de ? 'Mitglied werden' : 'Join the club'} h={[de ? 'Dein Platz' : 'Your seat', de ? 'im Team' : 'in the team']} />
      <p class="lead">{de ? 'Beitrittserklärung, Satzung und Haftungsausschluss stehen als PDF bereit.' : 'The membership application, statutes and liability waiver are available as PDFs (in German).'}</p>
      <div class="cta"><a class="btn red" href={href('mitglied', lang)}>{de ? 'Mitglied werden' : 'Join the club'}</a></div>
    </div>
    <Downloads lang={lang} />
  </div></section>

  <section class="sec" id="partner"><div class="w">
    <SectionHead kick="Partner" h={[de ? 'An unserer' : 'On our', de ? 'Seite' : 'side']} />
    <ul class="plogos">{partners.map((p) => <li><a href={p.href} rel="noopener" aria-label={de ? `${p.name}: Website öffnen (externer Link)` : `${p.name}: open website (external link, German)`}><img src={p.logo} width={p.w} height={p.h} loading="lazy" alt={de ? `Logo ${p.name}` : `${p.name} logo`} /></a></li>)}</ul>
    <div class="cta">
      <a class="btn" href={href('partner', lang)}>{de ? 'Partner und Sponsoren' : 'Partners and sponsors'}</a>
      <a class="btn red" href={href('kontakt', lang)}>{de ? 'Kontakt aufnehmen' : 'Get in touch'}</a>
    </div>
  </div></section>

  <script>
    import '../scripts/home.ts';
  </script>
</Base>

<style is:global>
/* Home only: layered hero, timing tower, scroll-driven photo strip */
.hero { position: relative; isolation: isolate; overflow: hidden; display: flex; min-height: clamp(470px, calc(82svh - var(--hh)), 700px); background: linear-gradient(180deg, #1d1314, var(--bg)); }
.ly { transform: translate3d(calc(var(--px, 0) * var(--m, 0) * 1px), calc(var(--sy, 0) * var(--k, 0) * 1px + var(--py, 0) * var(--m, 0) * 1px), 0); }
.hero-lines { --k: .5; --m: 10; position: absolute; inset: 0; z-index: -2; opacity: .8; background: repeating-linear-gradient(0deg, rgba(255, 236, 228, .07) 0 1px, transparent 1px 34px); -webkit-mask-image: linear-gradient(115deg, transparent 30%, #000 60%); mask-image: linear-gradient(115deg, transparent 30%, #000 60%); }
.hero-ghost { --k: .34; --m: 24; position: absolute; left: var(--gut); top: 3%; z-index: -1; display: flex; flex-direction: column; font: italic 800 clamp(5rem, 15vw, 14.5rem)/.82 var(--f-d); text-transform: uppercase; white-space: nowrap; color: transparent; -webkit-text-stroke: 1.5px rgba(255, 236, 228, .15); user-select: none; }
.hero-ghost span:last-child { padding-left: 1.1em; -webkit-text-stroke-color: rgba(255, 90, 80, .2); }
.hero-in { position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 18px; padding-block: min(54vw, 300px) 26px; perspective: 1100px; }
.hero-ph { --k: .13; --m: -12; position: absolute; inset: 0 0 auto 0; height: min(52vw, 280px); clip-path: polygon(0 0, 100% 0, 100% 84%, 0 100%); transform: translate3d(calc(var(--px, 0) * var(--m) * 1px), calc(var(--sy, 0) * var(--k) * 1px + var(--py, 0) * var(--m) * 1px), 0) rotateY(calc(var(--px, 0) * -5deg)) rotateX(calc(var(--py, 0) * 4deg)); }
.hero-ph img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 100%; filter: contrast(1.12) saturate(.94) brightness(.9); }
.hero-ph::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(19, 14, 14, .55) 0, transparent 40%); }
.hero-cheq { position: absolute; left: -10%; right: -10%; top: 12px; height: 20px; opacity: .9; background: repeating-conic-gradient(var(--ink) 0 25%, transparent 0 50%) 0 0/20px 20px; transform: translate3d(calc(var(--sy, 0) * -.45px + var(--px, 0) * 28px), calc(var(--sy, 0) * .05px), 0) rotate(-4deg); }
.hero-copy { --k: -.03; --m: 5; position: relative; z-index: 2; }
.hero-copy h1 { margin: 12px 0; font: italic 800 clamp(2.7rem, 11vw, 6.2rem)/.86 var(--f-d); text-transform: uppercase; text-wrap: balance; }
.hero-copy h1 span { display: block; }
.hero-copy h1 span:first-child { color: var(--red-t); }
.hero-copy .lead { color: var(--ink); max-width: 48ch; }
.tower { --k: -.09; --m: 16; position: relative; z-index: 3; background: rgba(10, 7, 7, .94); border-left: 4px solid var(--red); box-shadow: 0 24px 50px -20px #000; }
.tw-head { display: flex; align-items: center; gap: 9px; padding: 10px 12px; background: var(--red); color: #fff; font: italic 800 1.1rem/1 var(--f-d); letter-spacing: .07em; text-transform: uppercase; }
.tw-head span:last-child { margin-left: auto; font: 700 var(--t-xs)/1 var(--f-m); font-style: normal; letter-spacing: .08em; padding: 4px 6px; background: rgba(0, 0, 0, .35); }
.tw-rows { display: none; }
.tw-rows div { display: grid; grid-template-columns: 96px 1fr; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--line); font: 500 var(--t-xs)/1.3 var(--f-m); }
.tw-rows dt { color: var(--mute); text-transform: uppercase; letter-spacing: .06em; font-size: var(--t-xs); align-self: center; }
.tw-rows dd { text-align: right; }
.tw-note { padding: 9px 12px; font-size: var(--t-sm); }
/* photo strip: swipe by default, .is-3d = scroll-driven coverflow on large pointer devices */
.gal-track { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 max(var(--gut), env(safe-area-inset-left, 0px)) 14px; scrollbar-color: var(--red) transparent; }
.gal-track li { flex: 0 0 min(80vw, 520px); scroll-snap-align: center; }
.gal-track img { width: 100%; aspect-ratio: 3/2; object-fit: cover; }
.gal-track figcaption { padding: 9px 0; font-size: var(--t-sm); color: var(--mute); border-top: 2px solid var(--red); }
.gal-foot { display: flex; align-items: center; gap: 20px; margin-top: 14px; }
.gal-hud { display: none; flex: 1; }
.gal-bar { display: block; height: 4px; background: var(--line); }
.gal-bar i { display: block; height: 100%; background: var(--red); transform-origin: 0 50%; transform: scaleX(0); }
.gal3d.is-3d { height: calc(100svh + 620px); }
.gal3d.is-3d .gal-stage { position: sticky; top: var(--hh); height: calc(100svh - var(--hh)); overflow: hidden; padding-top: clamp(16px, 3svh, 36px); display: flex; flex-direction: column; }
.gal3d.is-3d .sh { margin-bottom: 0; }
.gal3d.is-3d .sh h2 { font-size: clamp(2.2rem, 4.2vw, 3.4rem); }
.gal3d.is-3d .gal-track { position: relative; flex: 1; min-height: 0; display: block; overflow: visible; padding: 0; perspective: 1300px; }
.gal3d.is-3d .gal-track li { position: absolute; left: 50%; top: 50%; width: min(50vw, 640px, calc((100svh - var(--hh) - 330px) * 1.5)); transform: translate(-50%, -50%); box-shadow: 0 30px 60px -20px #000; background: var(--bg); transition: opacity var(--d2); }
.gal3d.is-3d .gal-foot { margin: 0; padding-block: 12px 18px; }
.gal3d.is-3d .gal-hud { display: block; }
