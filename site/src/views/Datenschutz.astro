---
// Datenschutzerklärung / Privacy policy (Art. 13 DSGVO), written for exactly this static site.
// The whole body is DRAFT text for the club to have checked; each section's content is wrapped once in data-draft.
// Only the "grundsatz" section carries the substance of the old short Datenschutz paragraph (../crawl/content/impressum.md).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { club, type Lang } from '../data/club';
import { href } from '../i18n/routes';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const de = lang === 'de';
const DRAFT = 'Entwurf Datenschutz';
const TBD = de ? '[vom Verein zu ergänzen]' : '[vom Verein zu ergänzen – to be added by the club]';
const mail = `<a class="tlink" href="mailto:${club.email}">${club.email}</a>`;
const mapBtn = ui[lang].mapLoad;
const link = (key: Parameters<typeof href>[0], text: string, hash = '') => `<a class="tlink" href="${href(key, lang, hash)}">${text}</a>`;

type Sec = { id: string; h: string; body: string; old?: boolean };
const secs: Sec[] = de ? [
  { id: 'grundsatz', h: 'Grundsätzliches', old: true, body: `
    <p>Die Nutzung unserer Webseite ist in der Regel ohne Angabe personenbezogener Daten möglich. Soweit auf unseren Seiten personenbezogene Daten (beispielsweise Name, Anschrift oder E-Mail-Adressen) erhoben werden, erfolgt dies, soweit möglich, stets auf freiwilliger Basis. Diese Daten werden ohne Ihre ausdrückliche Zustimmung nicht an Dritte weitergegeben.</p>
    <p>Wir weisen darauf hin, dass die Datenübertragung im Internet (z. B. bei der Kommunikation per E-Mail) Sicherheitslücken aufweisen kann. Ein lückenloser Schutz der Daten vor dem Zugriff durch Dritte ist nicht möglich.</p>` },
  { id: 'verantwortlicher', h: 'Verantwortlicher', body: `
    <p>Verantwortlich für die Datenverarbeitung auf dieser Website im Sinne von Art. 4 Nr. 7 DSGVO ist:</p>
    <address>${club.name}<br>vertreten durch den Vorstand, 1. Vorsitzender Hans-Joachim Kamphowe<br>
    ${club.seat.label.de}: ${club.seat.street}, ${club.seat.city}<br>
    ${club.admin.label.de}: ${club.admin.street}, ${club.admin.city}<br>
    E-Mail: ${mail}<br>Telefon: ${TBD}</address>
    <p>Weitere Angaben zum Verein stehen im ${link('impressum', 'Impressum')}.</p>` },
  { id: 'datenschutzbeauftragter', h: 'Datenschutzbeauftragter', body: `
    <p>Der Verein hat keinen Datenschutzbeauftragten benannt. Eine Pflicht dazu besteht nach unserer Einschätzung nicht, weil im Verein nicht in der Regel mindestens 20 Personen ständig mit der automatisierten Verarbeitung personenbezogener Daten beschäftigt sind (§ 38 Abs. 1 BDSG). Bitte vom Vorstand bestätigen.</p>
    <p>Fragen zum Datenschutz richten Sie bitte direkt an den Vorstand: ${mail}.</p>` },
  { id: 'hosting', h: 'Hosting und Server-Logfiles', body: `
    <p class="note-box"><b>Hosting-Anbieter noch nicht final.</b> Dieser Abschnitt beschreibt den vorgesehenen Anbieter und muss angepasst werden, wenn ein anderer Anbieter gewählt wird.</p>
    <p>Diese Website besteht aus statischen Seiten. Es gibt keine Datenbank, keine Benutzerkonten und keine Anmeldung. Vorgesehen ist das Hosting bei Cloudflare Pages, einem Dienst der Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, USA. Cloudflare wird als Auftragsverarbeiter nach Art. 28 DSGVO für uns tätig; Grundlage ist ein Vertrag zur Auftragsverarbeitung [Abschluss vom Verein zu bestätigen].</p>
    <p>Bei jedem Aufruf einer Seite verarbeitet der Hosting-Anbieter technisch notwendige Daten und kann sie in Server-Logfiles speichern:</p>
    <ul><li>IP-Adresse des anfragenden Geräts</li><li>Datum und Uhrzeit der Anfrage</li><li>aufgerufene Adresse (URL) und übertragene Datenmenge</li><li>Statuscode der Antwort</li><li>zuvor besuchte Seite (Referrer), sofern Ihr Browser sie übermittelt</li><li>Browsertyp und Betriebssystem (User-Agent)</li></ul>
    <p>Zweck ist die Auslieferung der Website sowie die Gewährleistung von Stabilität und Sicherheit, etwa die Abwehr von Angriffen. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO; unser berechtigtes Interesse liegt im sicheren und störungsfreien Betrieb der Website. Wir führen diese Daten nicht mit anderen Daten zusammen und werten sie nicht personenbezogen aus. Speicherdauer der Logdaten beim Anbieter: ${TBD}.</p>
    <p>Dabei können Daten in die USA und in andere Länder übermittelt werden, in denen Cloudflare Rechenzentren betreibt. Für die USA stützt sich die Übermittlung auf den Angemessenheitsbeschluss der EU-Kommission zum EU-US Data Privacy Framework (Art. 45 DSGVO), sofern Cloudflare, Inc. darunter zertifiziert ist [bitte prüfen]. Ergänzend bzw. ersatzweise gelten die Standardvertragsklauseln der EU-Kommission (Art. 46 Abs. 2 lit. c DSGVO).</p>` },
  { id: 'cookies', h: 'Cookies und Speicher', body: `
    <p><b>Diese Website setzt keine Cookies und kein Tracking ein.</b> Es gibt keine Analyse-Werkzeuge, keine Werbenetzwerke und keine eingebundenen Inhalte sozialer Netzwerke.</p>
    <p>Die Schriften werden von unserem eigenen Server ausgeliefert (selbst gehostet). Es werden keine Google Fonts oder andere Schriftdienste von Dritten geladen.</p>
    <p>Weil wir keine Informationen auf Ihrem Endgerät speichern oder von dort auslesen, die nicht unbedingt erforderlich sind, ist nach § 25 TDDDG keine Einwilligung nötig. Deshalb gibt es auf dieser Website kein Cookie-Banner. Sollte der Verein später Funktionen ergänzen, die etwas in Ihrem Browser speichern, muss dieser Abschnitt angepasst werden.</p>` },
  { id: 'kontaktformular', h: 'Kontaktformular und E-Mail', body: `
    <p class="note-box"><b>Noch nicht angeschlossen.</b> Das ${link('kontakt', 'Kontaktformular')} ist derzeit mit keinem Mail-Dienst verbunden; es werden darüber noch keine Daten an uns übertragen. Dieser Abschnitt muss vervollständigt werden, sobald der Anbieter für den Versand feststeht (Name und Anschrift des Anbieters, Auftragsverarbeitung, ggf. Drittlandübermittlung): ${TBD}.</p>
    <p>Das Formular fragt folgende Angaben ab: Name, E-Mail, Betreff und Nachricht. Wir verwenden diese Angaben ausschließlich, um Ihre Anfrage zu bearbeiten und zu beantworten. Dasselbe gilt, wenn Sie uns direkt eine E-Mail schreiben; dann verarbeiten wir Ihre E-Mail-Adresse und den Inhalt Ihrer Nachricht. E-Mails an ${club.email} gehen im Postfach des Vereins beim E-Mail-Anbieter GMX ein [bitte prüfen].</p>
    <p>Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (unser berechtigtes Interesse, Anfragen an den Verein zu beantworten). Betrifft Ihre Anfrage eine Mitgliedschaft oder deren Anbahnung, etwa ein Probetraining oder eine Beitrittserklärung, ist Rechtsgrundlage Art. 6 Abs. 1 lit. b DSGVO.</p>
    <p>Ihre Angaben sind freiwillig; ohne E-Mail-Adresse können wir Ihnen allerdings nicht antworten. Wir geben die Daten nur an die Vorstandsmitglieder oder Ansprechpartner im Verein weiter, die für Ihr Anliegen zuständig sind.</p>
    <p>Wir löschen Anfragen, sobald sie abschließend bearbeitet sind und keine gesetzlichen Aufbewahrungspflichten entgegenstehen. Konkrete Löschfrist: ${TBD}.</p>` },
  { id: 'karte', h: 'Karte', body: `
    <p>Auf einigen Seiten zeigen wir den Weg zu uns auf einer Karte von OpenStreetMap. Die Karte wird nicht automatisch geladen. Zuerst sehen Sie nur einen Platzhalter; erst wenn Sie auf „${mapBtn}“ klicken, stellt Ihr Browser eine Verbindung zu den Servern von OpenStreetMap her.</p>
    <p>Ab diesem Klick werden Ihre IP-Adresse, Angaben zu Ihrem Browser und Gerät sowie die Adresse der Seite, von der aus Sie die Karte aufrufen (Referrer), an folgenden Anbieter übertragen:</p>
    <address>OpenStreetMap Foundation<br>St John’s Innovation Centre<br>Cowley Road<br>Cambridge, CB4 0WS<br>United Kingdom</address>
    <p>Rechtsgrundlage ist Ihre Einwilligung nach Art. 6 Abs. 1 lit. a DSGVO, die Sie mit dem Klick auf „${mapBtn}“ erteilen. Die Einwilligung gilt nur für den jeweiligen Seitenaufruf; wir speichern sie nicht. Wenn Sie die Seite neu laden, wird die Karte erst nach einem erneuten Klick wieder geladen. Sie können die Website vollständig nutzen, ohne die Karte zu laden.</p>
    <p>Die Daten werden im Vereinigten Königreich verarbeitet. Für das Vereinigte Königreich besteht ein Angemessenheitsbeschluss der EU-Kommission (Art. 45 DSGVO) [Fortgeltung bitte prüfen]. Wie die OpenStreetMap Foundation Daten verarbeitet, beschreibt sie in ihrer <a class="tlink ext" rel="noopener" href="https://osmfoundation.org/wiki/Privacy_Policy" hreflang="en">Datenschutzerklärung (englisch)</a>.</p>` },
  { id: 'externe-links', h: 'Externe Links', body: `
    <p>Unsere Seiten verweisen auf fremde Websites, zum Beispiel auf adac-sport.com (Ausschreibungen und Ergebnisse), auf den ADAC Ostwestfalen-Lippe, auf OpenStreetMap und auf die Websites unserer ${link('partner', 'Partner')}. Das sind gewöhnliche Links: Solange Sie einen Link nicht anklicken, werden keine Daten an diese Anbieter übertragen.</p>
    <p>Wenn Sie einen Link anklicken, verlassen Sie unsere Website. Für die Datenverarbeitung auf der Zielseite ist deren Betreiber verantwortlich; es gilt dessen Datenschutzerklärung.</p>` },
  { id: 'downloads', h: 'Downloads', body: `
    <p>Wir stellen Dokumente als PDF zum Herunterladen bereit, zum Beispiel Satzung, Beitrittserklärung und Haftungsausschluss. Beim Abruf einer Datei fallen nur die unter ${link('datenschutz', 'Hosting und Server-Logfiles', '#hosting')} genannten Daten an. Eine Registrierung ist nicht nötig, und wir erfassen nicht, wer welche Datei herunterlädt.</p>
    <p>Dokumente, die auf adac-sport.com liegen, sind externe Links (siehe ${link('datenschutz', 'Externe Links', '#externe-links')}).</p>
    <p>Wenn Sie ein ausgefülltes Formular, etwa die Beitrittserklärung, an den Verein senden, verarbeiten wir die Angaben darin für die Mitgliederverwaltung (Art. 6 Abs. 1 lit. b DSGVO). Hinweise zur Datenverarbeitung im Rahmen der Mitgliedschaft: ${TBD}.</p>` },
  { id: 'fotos', h: 'Fotos', body: `
    <p>In der ${link('galerie', 'Galerie')} und auf anderen Seiten zeigen wir Fotos von Veranstaltungen und vom Training des Vereins. Darauf können Personen erkennbar sein. Zweck ist, über das Vereinsleben und den Sport zu berichten.</p>
    <p>Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse des Vereins an Berichterstattung und Öffentlichkeitsarbeit), soweit nicht die Interessen der abgebildeten Personen überwiegen, sowie, wo eine Einwilligung eingeholt wurde, Art. 6 Abs. 1 lit. a DSGVO. Ergänzend beachten wir die §§ 22 und 23 des Kunsturhebergesetzes (KUG).</p>
    <p>Fotos, auf denen Minderjährige erkennbar sind, veröffentlichen wir nur mit Einwilligung der Sorgeberechtigten.</p>
    <p><b>Foto entfernen lassen:</b> Wenn Sie auf einem Foto zu sehen sind oder Ihr Kind abgebildet ist und Sie das nicht möchten, schreiben Sie eine E-Mail an ${mail} und nennen Sie das Foto (am besten mit der Adresse der Seite). Wir entfernen es umgehend. Eine erteilte Einwilligung können Sie jederzeit mit Wirkung für die Zukunft widerrufen.</p>
    <p class="note-box"><b>Vom Verein zu prüfen:</b> Für die Galerien aus dem Jahr 2016 (Jugend-Kart-Slalom, Youngster) muss der Verein prüfen, ob Einwilligungen der abgebildeten Personen bzw. der Sorgeberechtigten vorliegen. Fotos ohne geklärte Einwilligung, vor allem Nahaufnahmen von Kindern, sollten vor der Veröffentlichung entfernt werden.</p>` },
  { id: 'gaestebuch', h: 'Gästebuch', body: `
    <p>Das ${link('gaestebuch', 'Gästebuch')} ist noch nicht aktiv. Es können derzeit keine Einträge abgeschickt werden, und es werden darüber keine Daten verarbeitet.</p>
    <p>Dieser Abschnitt ist zu vervollständigen, bevor das Gästebuch in Betrieb geht (welche Angaben abgefragt und veröffentlicht werden, Rechtsgrundlage, Speicherdauer, Löschung von Einträgen auf Wunsch, eingesetzter Anbieter): ${TBD}.</p>` },
  { id: 'besucherzaehler', h: 'Besucherzähler', body: `
    <p>Der Besucherzähler im Fuß der Seite ist nicht angeschlossen. Er zählt derzeit nichts und verarbeitet keine Daten.</p>
    <p>Falls der Verein den Zähler aktiviert, muss er ohne Cookies und ohne Speicherung von IP-Adressen arbeiten, also nur anonyme Summen bilden. Dieser Abschnitt ist dann mit der eingesetzten Technik und dem Anbieter zu ergänzen: ${TBD}.</p>` },
  { id: 'rechte', h: 'Ihre Rechte', body: `
    <p>Sie haben uns gegenüber folgende Rechte hinsichtlich der Sie betreffenden personenbezogenen Daten:</p>
    <ul><li>Auskunft über die verarbeiteten Daten (Art. 15 DSGVO)</li><li>Berichtigung unrichtiger Daten (Art. 16 DSGVO)</li><li>Löschung (Art. 17 DSGVO)</li><li>Einschränkung der Verarbeitung (Art. 18 DSGVO)</li><li>Mitteilung einer Berichtigung, Löschung oder Einschränkung an Empfänger der Daten (Art. 19 DSGVO)</li><li>Datenübertragbarkeit (Art. 20 DSGVO)</li><li>Widerspruch gegen die Verarbeitung (Art. 21 DSGVO)</li></ul>
    <p><b>Widerspruchsrecht:</b> Soweit wir Daten auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO verarbeiten, können Sie der Verarbeitung jederzeit aus Gründen widersprechen, die sich aus Ihrer besonderen Situation ergeben (Art. 21 Abs. 1 DSGVO).</p>
    <p><b>Widerruf einer Einwilligung:</b> Eine erteilte Einwilligung können Sie jederzeit mit Wirkung für die Zukunft widerrufen (Art. 7 Abs. 3 DSGVO). Die Rechtmäßigkeit der bis zum Widerruf erfolgten Verarbeitung bleibt davon unberührt.</p>
    <p><b>Beschwerde:</b> Sie haben das Recht, sich bei einer Datenschutz-Aufsichtsbehörde zu beschweren (Art. 77 DSGVO), siehe ${link('datenschutz', 'Aufsichtsbehörde', '#aufsichtsbehoerde')}.</p>
    <p>Um Ihre Rechte auszuüben, genügt eine formlose E-Mail an ${mail}. Eine automatisierte Entscheidungsfindung oder ein Profiling findet nicht statt.</p>` },
  { id: 'aufsichtsbehoerde', h: 'Aufsichtsbehörde', body: `
    <p>Zuständige Aufsichtsbehörde für den Verein ist:</p>
    <address>Landesbeauftragte für Datenschutz und Informationsfreiheit Nordrhein-Westfalen<br>Kavalleriestraße 2–4<br>40213 Düsseldorf<br>E-Mail: <a class="tlink" href="mailto:poststelle@ldi.nrw.de">poststelle@ldi.nrw.de</a></address>
    <p class="note-box"><b>Bitte prüfen:</b> Anschrift und E-Mail-Adresse der Aufsichtsbehörde vor der Veröffentlichung mit den aktuellen Angaben der Behörde abgleichen.</p>
    <p>Sie können sich auch an die Aufsichtsbehörde Ihres Wohnorts oder Arbeitsplatzes wenden.</p>` },
  { id: 'stand', h: 'Stand', body: `
    <p>Stand dieser Datenschutzerklärung: November 2026. Wir passen sie an, wenn sich die Website oder die Rechtslage ändert, insbesondere sobald Hosting-Anbieter, Kontaktformular, Gästebuch oder Besucherzähler feststehen.</p>` },
] : [
  { id: 'grundsatz', h: 'General', old: true, body: `
    <p>As a rule, our website can be used without providing personal data. Where personal data (for example name, address or e-mail addresses) is collected on our pages, this is always done on a voluntary basis as far as possible. This data will not be passed on to third parties without your express consent.</p>
    <p>Please note that data transmission over the internet (for example when communicating by e-mail) can have security gaps. Complete protection of data against access by third parties is not possible.</p>` },
  { id: 'verantwortlicher', h: 'Controller (Verantwortlicher)', body: `
    <p>The controller for data processing on this website within the meaning of Art. 4 Nr. 7 DSGVO (the EU General Data Protection Regulation, GDPR) is:</p>
    <address>${club.name}<br>represented by its board (Vorstand), 1. Vorsitzender (chairman) Hans-Joachim Kamphowe<br>
    ${club.seat.label.en} (Vereinssitz): ${club.seat.street}, ${club.seat.city}<br>
    ${club.admin.label.en} (Verwaltungssitz): ${club.admin.street}, ${club.admin.city}<br>
    E-mail: ${mail}<br>Telephone: ${TBD}</address>
    <p>Further details about the club are in the ${link('impressum', 'legal notice')}.</p>` },
  { id: 'datenschutzbeauftragter', h: 'Data protection officer', body: `
    <p>The club has not appointed a data protection officer. In our assessment there is no obligation to do so, because the club does not as a rule have at least 20 persons constantly engaged in the automated processing of personal data (§ 38 Abs. 1 BDSG). To be confirmed by the board.</p>
    <p>Please send questions about data protection directly to the board: ${mail}.</p>` },
  { id: 'hosting', h: 'Hosting and server log files', body: `
    <p class="note-box"><b>Hosting provider not final yet (Hosting-Anbieter noch nicht final).</b> This section describes the intended provider and must be adjusted if a different provider is chosen.</p>
    <p>This website consists of static pages. There is no database, no user accounts and no login. The intended host is Cloudflare Pages, a service of Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, USA. Cloudflare acts for us as a processor (Auftragsverarbeiter) under Art. 28 DSGVO on the basis of a data processing agreement [conclusion to be confirmed by the club].</p>
    <p>Each time a page is requested, the hosting provider processes technically necessary data and may store it in server log files:</p>
    <ul><li>IP address of the requesting device</li><li>date and time of the request</li><li>address requested (URL) and amount of data transferred</li><li>status code of the response</li><li>previously visited page (referrer), if your browser sends it</li><li>browser type and operating system (user agent)</li></ul>
    <p>The purpose is to deliver the website and to ensure stability and security, for example to fend off attacks. The legal basis is Art. 6 Abs. 1 lit. f DSGVO; our legitimate interest lies in the secure and uninterrupted operation of the website. We do not combine this data with other data and do not evaluate it in relation to individuals. Retention period of log data at the provider: ${TBD}.</p>
    <p>In the process, data may be transferred to the USA and to other countries in which Cloudflare operates data centres. For the USA the transfer relies on the European Commission’s adequacy decision for the EU-US Data Privacy Framework (Art. 45 DSGVO), provided Cloudflare, Inc. is certified under it [please check]. In addition, or as a fallback, the European Commission’s standard contractual clauses apply (Art. 46 Abs. 2 lit. c DSGVO).</p>` },
  { id: 'cookies', h: 'Cookies and storage', body: `
    <p><b>This website uses no cookies and no tracking.</b> There are no analytics tools, no advertising networks and no embedded social media content.</p>
    <p>The fonts are delivered from our own server (self-hosted). No Google Fonts or other third-party font services are loaded.</p>
    <p>Because we do not store information on your device, or read information from it, that is not strictly necessary, no consent is required under § 25 TDDDG. That is why this website has no cookie banner. If the club later adds functions that store something in your browser, this section must be adjusted.</p>` },
  { id: 'kontaktformular', h: 'Contact form and e-mail', body: `
    <p class="note-box"><b>Not connected yet.</b> The ${link('kontakt', 'contact form')} is currently not connected to any mail service; no data is transmitted to us through it yet. This section must be completed as soon as the provider for sending is chosen (name and address of the provider, data processing agreement, any third-country transfer): ${TBD}.</p>
    <p>The form asks for the following details: name (Name), e-mail (E-Mail), subject (Betreff) and message (Nachricht). We use these details solely to handle and answer your enquiry. The same applies if you write us an e-mail directly; we then process your e-mail address and the content of your message. E-mails to ${club.email} arrive in the club’s mailbox at the e-mail provider GMX [please check].</p>
    <p>The legal basis is Art. 6 Abs. 1 lit. f DSGVO (our legitimate interest in answering enquiries to the club). If your enquiry concerns a membership or steps prior to one, such as a trial session or a membership application, the legal basis is Art. 6 Abs. 1 lit. b DSGVO.</p>
    <p>Providing your details is voluntary; without an e-mail address, however, we cannot reply to you. We pass the data on only to those board members or contact persons in the club who are responsible for your request.</p>
    <p>We delete enquiries as soon as they have been dealt with conclusively and no statutory retention obligations prevent this. Specific deletion period: ${TBD}.</p>` },
  { id: 'karte', h: 'Map', body: `
    <p>On some pages we show how to find us on a map from OpenStreetMap. The map is not loaded automatically. At first you see only a placeholder; your browser connects to the OpenStreetMap servers only when you click “${mapBtn}”.</p>
    <p>From that click on, your IP address, information about your browser and device and the address of the page from which you load the map (referrer) are transmitted to the following provider:</p>
    <address>OpenStreetMap Foundation<br>St John’s Innovation Centre<br>Cowley Road<br>Cambridge, CB4 0WS<br>United Kingdom</address>
    <p>The legal basis is your consent under Art. 6 Abs. 1 lit. a DSGVO, which you give by clicking “${mapBtn}”. The consent applies only to that page view; we do not store it. If you reload the page, the map is loaded again only after another click. You can use the whole website without loading the map.</p>
    <p>The data is processed in the United Kingdom. For the United Kingdom there is an adequacy decision of the European Commission (Art. 45 DSGVO) [please check that it is still in force]. The OpenStreetMap Foundation describes how it processes data in its <a class="tlink ext" rel="noopener" href="https://osmfoundation.org/wiki/Privacy_Policy">privacy policy</a>.</p>` },
  { id: 'externe-links', h: 'External links', body: `
    <p>Our pages refer to other websites, for example adac-sport.com (regulations and results), the ADAC Ostwestfalen-Lippe, OpenStreetMap and the websites of our ${link('partner', 'partners')}. These are ordinary links: as long as you do not click a link, no data is transferred to these providers.</p>
    <p>When you click a link, you leave our website. The operator of the target site is responsible for data processing there, and its privacy policy applies.</p>` },
  { id: 'downloads', h: 'Downloads', body: `
    <p>We provide documents as PDF downloads, for example the statutes, the membership application (Beitrittserklärung) and the liability waiver (all in German). When a file is retrieved, only the data described under ${link('datenschutz', 'Hosting and server log files', '#hosting')} is generated. No registration is needed, and we do not record who downloads which file.</p>
    <p>Documents located on adac-sport.com are external links (see ${link('datenschutz', 'External links', '#externe-links')}).</p>
    <p>If you send a completed form, such as the membership application, to the club, we process the details in it for membership administration (Art. 6 Abs. 1 lit. b DSGVO). Information on data processing in the context of membership: ${TBD}.</p>` },
  { id: 'fotos', h: 'Photos', body: `
    <p>In the ${link('galerie', 'gallery')} and on other pages we show photos of the club’s events and training. People may be recognisable in them. The purpose is to report on club life and the sport.</p>
    <p>The legal basis is Art. 6 Abs. 1 lit. f DSGVO (the club’s legitimate interest in reporting and public relations), unless the interests of the persons shown prevail, and, where consent has been obtained, Art. 6 Abs. 1 lit. a DSGVO. We also observe §§ 22 and 23 of the Kunsturhebergesetz (KUG, the German act on the right to one’s own image).</p>
    <p>We publish photos in which minors are recognisable only with the consent of their legal guardians (Sorgeberechtigte).</p>
    <p><b>Having a photo removed:</b> if you or your child appear in a photo and you do not want that, send an e-mail to ${mail} and tell us which photo (ideally with the address of the page). We will remove it without delay. You can withdraw any consent given at any time with effect for the future.</p>
    <p class="note-box"><b>To be checked by the club:</b> for the galleries from 2016 (Jugend-Kart-Slalom, Youngster) the club must check whether consents from the persons shown, or from their legal guardians, exist. Photos without clarified consent, especially close-ups of children, should be removed before publication.</p>` },
  { id: 'gaestebuch', h: 'Guestbook', body: `
    <p>The ${link('gaestebuch', 'guestbook')} is not active yet. No entries can be submitted at present, and no data is processed through it.</p>
    <p>This section is to be completed before the guestbook goes live (which details are requested and published, legal basis, retention period, deletion of entries on request, provider used): ${TBD}.</p>` },
  { id: 'besucherzaehler', h: 'Visitor counter', body: `
    <p>The visitor counter in the page footer is not connected. It currently counts nothing and processes no data.</p>
    <p>If the club activates the counter, it must work without cookies and without storing IP addresses, that is, it may only form anonymous totals. This section is then to be completed with the technology and provider used: ${TBD}.</p>` },
  { id: 'rechte', h: 'Your rights', body: `
    <p>You have the following rights towards us regarding personal data concerning you:</p>
    <ul><li>access to the data processed (Art. 15 DSGVO)</li><li>rectification of inaccurate data (Art. 16 DSGVO)</li><li>erasure (Art. 17 DSGVO)</li><li>restriction of processing (Art. 18 DSGVO)</li><li>notification of rectification, erasure or restriction to recipients of the data (Art. 19 DSGVO)</li><li>data portability (Art. 20 DSGVO)</li><li>objection to processing (Art. 21 DSGVO)</li></ul>
    <p><b>Right to object:</b> where we process data on the basis of Art. 6 Abs. 1 lit. f DSGVO, you may object to the processing at any time on grounds relating to your particular situation (Art. 21 Abs. 1 DSGVO).</p>
    <p><b>Withdrawal of consent:</b> you can withdraw consent you have given at any time with effect for the future (Art. 7 Abs. 3 DSGVO). The lawfulness of processing carried out before the withdrawal remains unaffected.</p>
    <p><b>Complaint:</b> you have the right to lodge a complaint with a data protection supervisory authority (Art. 77 DSGVO), see ${link('datenschutz', 'Supervisory authority', '#aufsichtsbehoerde')}.</p>
    <p>To exercise your rights, an informal e-mail to ${mail} is sufficient. There is no automated decision-making and no profiling.</p>` },
  { id: 'aufsichtsbehoerde', h: 'Supervisory authority', body: `
    <p>The supervisory authority responsible for the club is:</p>
    <address>Landesbeauftragte für Datenschutz und Informationsfreiheit Nordrhein-Westfalen<br>Kavalleriestraße 2–4<br>40213 Düsseldorf<br>E-mail: <a class="tlink" href="mailto:poststelle@ldi.nrw.de">poststelle@ldi.nrw.de</a></address>
    <p class="note-box"><b>Please check (bitte prüfen):</b> compare the authority’s postal and e-mail address with the authority’s current details before publication.</p>
    <p>You may also contact the supervisory authority of your place of residence or work.</p>` },
  { id: 'stand', h: 'Last updated', body: `
    <p>This privacy policy was last updated in November 2026. We will adjust it when the website or the legal situation changes, in particular once the hosting provider, contact form, guestbook or visitor counter are settled.</p>` },
];
---
<Base lang={lang} page="datenschutz"
  description={de
    ? 'Datenschutzerklärung des AC Herringhausen e.V. im ADAC: keine Cookies, kein Tracking, Karte erst nach Klick. Welche Daten diese Website verarbeitet und welche Rechte Sie haben.'
    : 'Privacy policy of AC Herringhausen e.V. im ADAC: no cookies, no tracking, map only after a click. What data this website processes and what rights you have.'}>
  <PageHero lang={lang} page="datenschutz" h1={de ? ['Datenschutz'] : ['Privacy', 'policy']} ghost={de ? 'DSGVO' : 'GDPR'}
    lead={de
      ? 'Keine Cookies, kein Tracking, Karte erst nach Klick. Hier steht, welche Daten diese Website verarbeitet.'
      : 'No cookies, no tracking, map only after a click. This page explains what data this website processes.'} />

  <section class="sec paper">
    <div class="w">
      <div class="prose wide lg">
        <p class="note-box" role="note">
          <b>{de ? 'Entwurf:' : 'Draft:'}</b>{' '}
          {de
            ? 'Dieser Text wurde beim Neuaufbau der Website erstellt und muss vor der Veröffentlichung vom Vorstand bzw. rechtlich geprüft werden.'
            : 'This text was written when the website was rebuilt and must be checked by the board, or legally, before publication.'}
        </p>
        {!de && (
          <p><b>The German version of this page is the binding one.</b> This English text is a translation for your convenience; German legal terms, names and addresses are left in German (DSGVO = GDPR, BDSG = Federal Data Protection Act, TDDDG = Telecommunications and Digital Services Data Protection Act). <a class="tlink" href={href('datenschutz', 'de')} hreflang="de" lang="de">Datenschutzerklärung (Deutsch)</a></p>
        )}

        <nav class="lg-toc" aria-labelledby="lg-toc-h">
          <p class="h4" id="lg-toc-h">{de ? 'Inhalt' : 'Contents'}</p>
          <ol>
            {secs.map((s) => <li><a href={`#${s.id}`}>{s.h}</a></li>)}
          </ol>
        </nav>

        {secs.map((s) => (
          <section id={s.id} aria-labelledby={`${s.id}-h`}>
            <h2 id={`${s.id}-h`}>{s.h}</h2>
            {s.old
              ? <div class="lg-body" set:html={s.body} />
              : <div class="lg-body" data-draft={DRAFT} set:html={s.body} />}
          </section>
        ))}

        <div class="cta">
          <a class="btn red" href={href('kontakt', lang)}>{de ? 'Frage zum Datenschutz stellen' : 'Ask a privacy question'}</a>
          <a class="btn" href={href('impressum', lang)}>{de ? 'Zum Impressum' : 'To the legal notice'}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* legal pages only (prefix lg) */
  .lg > section { scroll-margin-top: 96px; }
  .lg > section > h2 { margin-top: 1.5em; }
  .lg > section > * + *, .lg .lg-body > * + * { margin-top: 1.05em; }
  .lg p, .lg li { hyphens: auto; }
  .lg-toc { padding: 18px 20px; background: #fff; border-top: 3px solid var(--red-d); }
  .lg-toc ol { margin-top: .7em; padding: 0; list-style: none; display: grid; gap: .1em 28px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .lg-toc a { display: block; padding: .38em 0; font-weight: 600; text-decoration-color: var(--red-d); }
  .lg-toc a:hover { text-decoration-color: currentColor; }
</style>
