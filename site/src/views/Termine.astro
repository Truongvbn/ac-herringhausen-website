---
// Termine: merges the old pages "Termine 2026", "Ausschreibungen" and the results link from "Aktuelles".
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import EventRows from '../components/EventRows.astro';
import SubNav from '../components/SubNav.astro';
import Next from '../components/Next.astro';
import { events2026, archiveDocs, meetings, type Lang } from '../data/club';
import { href } from '../i18n/routes';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const de = lang === 'de';
const t = ui[lang];
const today = new Date().toISOString().slice(0, 10);
const total = events2026.length;
const done = events2026.filter((e) => e.date < today).length;
const over = done === total;
const next = events2026.find((e) => e.date >= today);
const pos = (d: string) => (((Date.parse(d) - Date.parse('2026-01-01')) / 864e5 / 365) * 100).toFixed(1);
const months = (de ? ['Jan', 'Apr', 'Jul', 'Okt'] : ['Jan', 'Apr', 'Jul', 'Oct']).map((m, i) => ({ m, x: pos(`2026-${['01', '04', '07', '10'][i]}-01`) }));
const dm = (d: string) => `${d.slice(8, 10)}.${d.slice(5, 7)}.`;
const status = de
  ? `Saison 2026: ${done} von ${total} Veranstaltungen gefahren`
  : `Season 2026: ${done} of ${total} events completed`;
// Newest first. The 2026 entry is not from the old site (found via the DMSB calendar, link unchecked).
const draftDoc = {
  year: 2026,
  event: de ? '55. ADAC Clubsport Slalom AC Herringhausen' : '55th ADAC Clubsport Slalom AC Herringhausen',
  label: de ? 'Virtueller Aushang' : 'Online notice board',
  href: 'https://www.adac-sport.com/55_ADAC_Clubsport_Slalom_AC_Herringhaus_21544/TW_ON_Virtueller_Aushang.php',
};
const docs = [...archiveDocs].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const open = de ? 'Auf adac-sport.com öffnen' : 'Open on adac-sport.com';
---
<Base lang={lang} page="termine"
  description={de
    ? 'Termine 2026 des AC Herringhausen e.V. im ADAC: Jugend-Kart-Slalom, Clubsport-Slalom, Ausschreibungen und Ergebnisse, Versammlung, Clubabend und Kart-Training.'
    : 'AC Herringhausen e.V. im ADAC events 2026: youth kart slalom, clubsport slalom, regulations and results, members’ meeting, club evening and kart training.'}>
  <PageHero lang={lang} page="termine"
    h1={[de ? 'Termine' : 'Events', '2026']}
    lead={de
      ? 'Drei Veranstaltungen in der Saison 2026, dazu das Kart-Training an jedem Samstag und zwei feste Donnerstage im Monat.'
      : 'Three events in the 2026 season, plus kart training every Saturday and two fixed Thursdays a month.'}
    ghost={de ? 'Termine' : 'Events'}
    img="/img/hero/img-1958.webp"
    alt={de ? 'Kart auf dem Slalomkurs mit Streckenposten' : 'Kart on the slalom course with a marshal'}
    caption={de ? 'Auf dem Slalomkurs, Streckenposten im Blick' : 'On the slalom course, marshal in view'}>
  </PageHero>

  <SubNav label={de ? 'Auf dieser Seite' : 'On this page'} items={[
    { href: '#naechstes', label: de ? 'Als Nächstes' : 'Up next' },
    { href: '#saison', label: de ? 'Saison 2026' : 'Season 2026' },
    { href: '#unterlagen', label: de ? 'Ausschreibungen & Ergebnisse' : 'Regulations & results' },
    { href: '#regelmaessig', label: de ? 'Feste Termine' : 'Regular dates' },
  ]} />

  <section class="sec tight" id="naechstes" aria-labelledby="nx-h"><div class="w">
    <div class="feat">
      <div class="feat-c">
        <p class="kick"><b>{next ? (de ? 'Nächste Veranstaltung' : 'Next event') : t.nextTraining}</b><span>{next ? next.date.slice(0, 4) : t.weekly}</span></p>
        {next
          ? <><h2 id="nx-h">{next.title[lang]}</h2>{next.place && <p>{next.place[lang]}</p>}{next.note && <p class="yel">{next.note[lang]}</p>}</>
          : <><h2 id="nx-h">{de ? 'Kart-Training, jeden Samstag' : 'Kart training, every Saturday'}</h2>
              <p><span data-next-date>{t.saturday}</span> · {t.clock} · {t.trainingPlace} · {t.trainingNote}</p></>}
        <div class="cta">
          {next
            ? <a class="btn red" href="#unterlagen">{t.ausschreibung} &amp; {t.ergebnisse}</a>
            : <a class="btn red" href={href('kart', lang, '#probetraining')}>{t.trial}</a>}
          <a class="btn" href="#saison">{de ? 'Saison 2026' : 'Season 2026'}</a>
        </div>
      </div>
      <div class="feat-t">
        {next
          ? <p class="feat-day"><b>{dm(next.date)}</b><span>{next.date.slice(0, 4)}</span></p>
          : <div class="tw-clock" role="timer" aria-label={t.nextTraining}>
              <div><b data-cd="d">00</b><span>{t.days}</span></div><div><b data-cd="h">00</b><span>{t.hrs}</span></div><div><b data-cd="m">00</b><span>{t.min}</span></div><div><b data-cd="s">00</b><span>{t.sec}</span></div>
            </div>}
      </div>
    </div>
  </div></section>

  <section class="sec alt" id="saison"><div class="w">
    <SectionHead kick={de ? 'Veranstaltungen' : 'Events'} h={[de ? 'Saison' : 'Season', '2026']} />
    <p class="track-cap">{status}</p>
    <div class="track" aria-hidden="true">
      <b style={`width:${today.slice(0, 4) > '2026' ? 100 : pos(today)}%`}></b>
      {events2026.map((e) => <i class:list={{ done: e.date < today }} style={`left:${pos(e.date)}%`}><span>{dm(e.date)}</span></i>)}
      <p class="mon">{months.map((m) => <span style={`left:${m.x}%`}>{m.m}</span>)}</p>
    </div>
    {over && <p class="flag">{de ? 'Saison 2026 beendet · Termine 2027 folgen' : 'Season 2026 finished · 2027 dates to follow'}</p>}
    <EventRows lang={lang} />
  </div></section>

  <section class="sec" id="unterlagen"><div class="w">
    <SectionHead kick={de ? 'Unterlagen' : 'Documents'} h={[de ? 'Ausschreibungen' : 'Regulations', de ? '& Ergebnisse' : '& results']} />
    <p class="lead">{de
      ? 'Ausschreibungen und Ergebnisse unserer Veranstaltungen werden auf adac-sport.com veröffentlicht. Die Links öffnen die jeweilige Seite dort.'
      : 'Regulations (Ausschreibungen) and results for our events are published on adac-sport.com. The links open the relevant page there; the documents are in German.'}</p>
    <ol class="board">
      <li data-draft="Link nicht geprüft, vom Club zu bestätigen">
        <span class="b-year num">{draftDoc.year}</span>
        <span class="b-main"><b>{draftDoc.event}</b><span>{draftDoc.label}</span></span>
        <a class="tlink ext" href={draftDoc.href} rel="noopener" aria-label={`${draftDoc.event}: ${draftDoc.label}, ${open}`}>{open}</a>
      </li>
      {docs.map((d) => (
        <li>
          <span class="b-year num">{d.year}</span>
          <span class="b-main"><b>{d.event[lang]}</b><span>{d.label[lang]}</span></span>
          <a class="tlink ext" href={d.href} rel="noopener" aria-label={`${d.event[lang]}: ${d.label[lang]}, ${open}`}>{open}</a>
        </li>
      ))}
    </ol>
  </div></section>

  <section class="sec alt" id="regelmaessig"><div class="w">
    <SectionHead kick={de ? 'Jeden Monat, jede Woche' : 'Every month, every week'} h={[de ? 'Feste' : 'Regular', de ? 'Termine' : 'dates']} />
    <div class="life tm-life">
      {meetings.map((m) => <div class="slot"><b>{m.title[lang]}</b><span>{m.when[lang]}</span><em>{m.time[lang]}</em></div>)}
      <div class="slot"><b>{de ? 'Kart-Training' : 'Kart training'}</b><span>{de ? 'Jeden Samstag' : 'Every Saturday'}, {t.trainingPlace} ({t.trainingNote})</span><em>{t.clock}</em></div>
    </div>
    <p class="mute" style="margin-top:16px;max-width:60ch">{de
      ? 'Versammlung und Clubabend finden im Clublokal statt: Zum Mittelpunkt bei Babi, Milchstraße 193, 32120 Hiddenhausen.'
      : 'The members’ meeting and the club evening take place at the clubhouse: Zum Mittelpunkt bei Babi, Milchstraße 193, 32120 Hiddenhausen.'}
      {' '}<a class="tlink" href={href('verein', lang, '#aktuelles')}>{de ? 'Anfahrt und Karte' : 'Directions and map'}</a></p>
  </div></section>

  <Next art="stopwatch" kick={de ? 'Wie geht es weiter?' : 'Where next?'} h={[de ? 'Der nächste' : 'The next', de ? 'Schritt' : 'step']}>
    <a class="btn red" href={href('kart', lang)}>{de ? 'Zum Jugend-Kart-Slalom' : 'Youth kart slalom'}</a>
    <a class="btn" href={href('clubsport', lang)}>{de ? 'Zum Clubsport-Slalom' : 'Clubsport slalom'}</a>
    <a class="btn" href={href('kontakt', lang)}>{de ? 'Kontakt aufnehmen' : 'Get in touch'}</a>
  </Next>
</Base>

<style>
  /* document board: one line per document, like a notice board at the track */
  .board { margin-top: 26px; border-top: 2px solid var(--ink); }
  .board li { display: grid; grid-template-columns: 1fr; gap: 6px 20px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .b-year { font-weight: 700; font-size: 1rem; color: var(--yel); }
  .b-main { min-width: 0; }
  .b-main b { display: block; font: 600 var(--t-lg)/1.3 var(--f-b); hyphens: auto; overflow-wrap: anywhere; }
  .b-main span { display: block; font: 500 var(--t-xs)/1.4 var(--f-m); letter-spacing: .06em; text-transform: uppercase; color: var(--mute); }
  .board a { justify-self: start; padding-block: 6px; }
  @media (min-width: 760px) {
    .board li { grid-template-columns: 72px 1fr auto; align-items: center; padding-inline: 4px; }
    .board a { justify-self: end; }
  }
  @media (min-width: 900px) { .tm-life { grid-template-columns: repeat(3, 1fr); } }
</style>
