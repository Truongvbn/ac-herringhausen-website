---
import Base from '../layouts/Base.astro';
import { href } from '../i18n/routes';
---
<Base lang="de" page="home" title="Seite nicht gefunden" description="Diese Seite gibt es nicht (mehr).">
  <section class="sec"><div class="w">
    <p class="kick"><b>404</b><span>Seite nicht gefunden · Page not found</span></p>
    <h1 class="h-d">Falsch abgebogen.</h1>
    <p class="lead" style="margin-top:16px">Diese Seite gibt es nicht (mehr). Die Adressen der alten Website wurden umgezogen. · This page does not exist (any more).</p>
    <div class="cta">
      <a class="btn red" href={href('home', 'de')}>Zur Startseite</a>
      <a class="btn" href={href('sitemap', 'de')}>Sitemap</a>
      <a class="btn" href={href('home', 'en')} lang="en">English home</a>
    </div>
  </div></section>
</Base>
