---
import type { Lang } from '../data/club';
import { href } from '../i18n/routes';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
---
<aside class="chip" aria-label={t.nextTraining}>
  <div class="w chip-in">
    <span class="lbl">{t.nextTraining}</span>
    <span><b data-next-date>{t.saturday}</b> · <b>{t.clock}</b></span>
    <span>{t.trainingPlace}</span>
    <span class="mute">{t.trainingNote}</span>
    <a href={href('kart', lang, '#probetraining')}>{t.trial} →</a>
  </div>
</aside>
