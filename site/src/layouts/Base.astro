---
import '@fontsource/barlow-condensed/latin-600-italic.css';
import '@fontsource/barlow-condensed/latin-800-italic.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrainingChip from '../components/TrainingChip.astro';
import { club, type Lang } from '../data/club';
import { routes, type PageKey } from '../i18n/routes';
import { ui, titles } from '../i18n/ui';

interface Props { lang: Lang; page: PageKey; title?: string; description: string; chip?: boolean; }
const { lang, page, title, description, chip = true } = Astro.props;
const t = ui[lang];
const pageTitle = page === 'home'
  ? `${club.name} · Motorsport in Herford / Hiddenhausen`
  : `${title ?? titles[page][lang]} · ${club.name}`;
const abs = (p: string) => new URL(p, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(routes[page][lang])} />
    <link rel="alternate" hreflang="de" href={abs(routes[page].de)} />
    <link rel="alternate" hreflang="en" href={abs(routes[page].en)} />
    <link rel="alternate" hreflang="x-default" href={abs(routes[page].de)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#130e0e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs('/img/art/og.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
  </head>
  <body data-page={page} data-lang={lang} class:list={{ 'show-drafts': import.meta.env.PUBLIC_SHOW_DRAFTS !== '0' }}>
    <a class="skip" href="#inhalt">{t.skip}</a>
    <Header lang={lang} page={page} />
    {chip && <TrainingChip lang={lang} />}
    <main id="inhalt">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
